# =========================================================
# Template Konfigurasi Database (.env.example)
# =========================================================

# Salin file ini menjadi .env dan sesuaikan nilainya:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=learn-tracker

# Untuk Railway (otomatis terdeteksi):
# MYSQLHOST=mysql.railway.internal
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=your_password
# MYSQLDATABASE=railway

# Fase 2: migrasi & cache
# DB_AUTO_MIGRATE=1  # set 0 di production, migrasi via: php db/migrate.php --up
# DB_READ_HOST=      # host read-replica opsional (kosong = pakai koneksi tulis)
# REDIS_URL=         # mis. redis://127.0.0.1:6379 (kosong = cache file lokal)
# CACHE_DISABLED=    # set 1 untuk menonaktifkan cache (debug)

# Fase 3: stateless & observability
# SESSION_DRIVER=file  # file | redis | db (db butuh migrasi 034_sessions)
# SESSION_LIFETIME=120 # menit
# REDIS_HOST=        # alternatif REDIS_URL untuk session/cache
# REDIS_PORT=6379
